{
  "hosting": {
    "source": ".",
    "frameworksBackend": { "region": "us-central1" },
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"]
  },
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json" },
  "storage": { "rules": "storage.rules" },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "storage": { "port": 9199 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
